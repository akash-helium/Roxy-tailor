        { "type": "checkbox", "id": "show_tax_note", "label": "Show tax note", "default": false },
        { "type": "checkbox", "id": "show_net_content", "label": "Show net content", "default": true },

        { "type": "checkbox", "id": "show_sale_badge", "label": "Show sale badge", "default": true },
        { "type": "select", "id": "sale_badge_type", "label": "Sale badge type", "default": "percentage", "options": [
