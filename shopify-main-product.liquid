    },
    {
      "type": "link", "name": "Link text",
      "settings": [
        { "type": "text", "id": "text", "default": "Link text", "label": "Text" },
        { "type": "url", "id": "url", "label": "URL" },
        { "type": "checkbox", "id": "open_new_tab", "label": "Open link in new tab", "default": false },
        { "type": "select", "id": "style", "label": "Style", "options": [
