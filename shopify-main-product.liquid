      ]
    },
    { "type": "feature_tags", "name": "Feature Tags" },
    {
      "type": "sku", "name": "SKU", "limit": 1,
      "settings": [
        { "type": "select", "id": "text_style", "options": [
          { "value": "body", "label": "Body" },
          { "value": "subheading", "label": "Subheading" },
          { "value": "uppercase", "label": "Uppercase" }
        ], "default": "body", "label": "Text style" }
      ]
    },
    {
      "type": "available_offers", "name": "Available Offers", "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "AVAILABLE OFFERS" },
        { "type": "header", "content": "Colors" },
        { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#050505" },
        { "type": "color", "id": "text_color", "label": "Text Color", "default": "#ffffff" },
        { "type": "header", "content": "Layout" },
        { "type": "range", "id": "max_width", "min": 400, "max": 1200, "step": 20, "unit": "px", "label": "Maximum Width", "default": 600 },
        { "type": "range", "id": "border_radius", "min": 0, "max": 20, "step": 2, "unit": "px", "label": "Corner Radius", "default": 20 },
        { "type": "range", "id": "padding_x", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Horizontal Padding", "default": 20 },
        { "type": "range", "id": "padding_y", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Vertical Padding", "default": 30 },
        { "type": "range", "id": "margin_top", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Top Margin", "default": 40 },
        { "type": "range", "id": "margin_bottom", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Bottom Margin", "default": 40 }
      ]
    },
    {
