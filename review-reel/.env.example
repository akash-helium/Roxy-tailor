# Shopify Partner Dashboard → Apps → Create app → Client credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Auto-set by `shopify app dev` tunnel
SHOPIFY_APP_URL=

# Comma-separated scopes (must match shopify.app.toml)
SCOPES=read_products,read_orders

# SQLite for local dev. Use PostgreSQL in production.
DATABASE_URL="file:./dev.sqlite"

# Set true in dev to avoid real charges
SHOPIFY_BILLING_TEST=true

# ─── Creatomate (video engine) ───────────────────────────────────────────────
# Sign up free: https://creatomate.com (50 credits, no credit card)
CREATOMATE_API_KEY=

# Optional: use a custom template from Creatomate editor instead of built-in RenderScript
# CREATOMATE_TEMPLATE_ID=

# Legacy alias (still supported)
# VIDEO_API_KEY=
