NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional fallback if auth login fails (uuid from Supabase profiles table, login_id = admin)
VITE_SHOP_USER_ID=your-shop-admin-user-uuid

# Mobile app: bun run dev (port 5173) -> bun run build -> bun run build:android
# Admin website: bun run dev:admin (port 5174) -> bun run build:admin -> deploy admin/dist/

# Only for scripts/setup-default-user.mjs (never expose in the app)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OTA (free, self-hosted on Supabase Storage). Run supabase/app-ota-storage.sql once,
# then bun run publish:ota after UI changes. Optional override:
# VITE_OTA_MANIFEST_URL=https://your-project.supabase.co/storage/v1/object/public/app-ota/latest.json

# WhatsApp via RichAutomate (server/desktop only — do not prefix with VITE_)
# Dashboard → Settings → API Keys. Template: Connect → WhatsApp → Templates (approved).
RICHAUTOMATE_API_KEY=your-richautomate-api-key
WHATSAPP_TEMPLATE_NAME=welcome_message
WHATSAPP_TEMPLATE_LANG=en_US
# Set only if the template has {{1}} {{2}} … placeholders. WELCOME_MESSAGE has none.
WHATSAPP_TEMPLATE_BODY_PARAMS=0
# Optional: put the same keys in %APPDATA%\Roxy Tailor\whatsapp.env for the Windows app
# Phone/APK also needs:
#   bunx supabase secrets set RICHAUTOMATE_API_KEY=... WHATSAPP_TEMPLATE_NAME=welcome_message WHATSAPP_TEMPLATE_LANG=en_US
#   bunx supabase functions deploy send-whatsapp
