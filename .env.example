NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional fallback if auth login fails (uuid from Supabase profiles table, login_id = admin)
VITE_SHOP_USER_ID=your-shop-admin-user-uuid

# Mobile app: bun run dev (port 5173) -> bun run build -> bun run build:android
# Admin website: bun run dev:admin (port 5174) -> bun run build:admin -> deploy admin/dist/

# Only for scripts/setup-default-user.mjs (never expose in the app)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp Cloud API (server/desktop only — do not prefix with VITE_)
# Meta Business Suite → WhatsApp → API Setup
WHATSAPP_TOKEN=your-whatsapp-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# Required for shop-initiated messages. Template body example:
# Hello {{1}}, your order is confirmed at Roxy Tailor. Order number: {{2}}. Items: {{3}}.
WHATSAPP_TEMPLATE_NAME=order_confirmed
WHATSAPP_TEMPLATE_LANG=en
# Deploy the function (needed for phone/APK):
#   bunx supabase secrets set WHATSAPP_TOKEN=... WHATSAPP_PHONE_NUMBER_ID=... WHATSAPP_TEMPLATE_NAME=order_confirmed
#   bunx supabase functions deploy send-whatsapp
# Optional: put the same keys in %APPDATA%\Roxy Tailor\whatsapp.env for the Windows app
